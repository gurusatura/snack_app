# Database Connection Strings (from Supabase Project Settings -> Database)
# Session pooler URL (IPv4 compatible, default port 5432 or 6543) - used by the running FastAPI app
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres

# Direct connection URL - used by Alembic migrations
DIRECT_URL=postgresql://postgres:yourpassword@db.yourprojectref.supabase.co:5432/postgres

# Security / JWT
# Generate via: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_32_byte_hex_string
JWT_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins or single origin)
CORS_ORIGIN=http://localhost:3000

# Demo Seed Credentials (used by seed.py)
SEED_ADMIN_EMAIL=admin@snackoverflow.local
SEED_ADMIN_PASSWORD=AdminPassword123!
SEED_MEMBER1_EMAIL=member1@snackoverflow.local
SEED_MEMBER1_PASSWORD=Member1Password123!
SEED_MEMBER2_EMAIL=member2@snackoverflow.local
SEED_MEMBER2_PASSWORD=Member2Password123!
